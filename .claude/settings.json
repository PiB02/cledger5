{
  "enabledMcpjsonServers": [
    "vercel","supabase"
  ],
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Edit",
      "Bash(ls:*)",
      "Bash(gh:*)", 
      "Bash(powershell:*)",
      "Bash(netstat:*)",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(cmd:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Read(~/.zshrc)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(curl:*)"
    ]
  }
}